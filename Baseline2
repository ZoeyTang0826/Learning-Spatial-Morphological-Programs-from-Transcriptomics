import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.mixture import GaussianMixture
from sklearn.cluster import KMeans
from sklearn.metrics import adjusted_rand_score, normalized_mutual_info_score

# Required files
TSNE_FILE = "TSNE/gene_tsne.csv"                    
LEIDEN_FILE = "Leiden/leiden_clusters.csv"         
MORPH_FILE = "patch-seq_preprocess/morphology_selected_scaled.csv"  
TSNE_COL1 = "tSNE1"
TSNE_COL2 = "tSNE2"

LEIDEN_COL = "Leiden_cluster"

# Morphology clustering method: "gmm" or "kmeans"
MORPH_CLUSTER_METHOD = "gmm"

N_MORPH_CLUSTERS = None

# Pick a few morphology features to visualize continuously on the gene tSNE
# Change these to actual column names in your morphology file
MORPH_FEATURES_TO_PLOT = [
    "total_dendritic_length",
    "max_branch_order",
    "num_branches"
]

# Output directory prefix (plots saved in current folder)
PLOT_PREFIX = "baseline2"

# ============================================================
# Load data
# ============================================================

tsne_df = pd.read_csv(TSNE_FILE, index_col=0)
leiden_df = pd.read_csv(LEIDEN_FILE, index_col=0)
morph_df = pd.read_csv(MORPH_FILE, index_col=0)

print("Loaded:")
print("tSNE:", tsne_df.shape)
print("Leiden:", leiden_df.shape)
print("Morphology:", morph_df.shape)

# ============================================================
# Align cells by shared index
# ============================================================

common_cells = tsne_df.index.intersection(leiden_df.index).intersection(morph_df.index)

tsne_df = tsne_df.loc[common_cells].copy()
leiden_df = leiden_df.loc[common_cells].copy()
morph_df = morph_df.loc[common_cells].copy()

print("\nAfter alignment:")
print("tSNE:", tsne_df.shape)
print("Leiden:", leiden_df.shape)
print("Morphology:", morph_df.shape)

# ============================================================
# Basic checks
# ============================================================

if TSNE_COL1 not in tsne_df.columns or TSNE_COL2 not in tsne_df.columns:
    raise ValueError(f"Could not find tSNE columns '{TSNE_COL1}' and '{TSNE_COL2}' in {TSNE_FILE}")

if LEIDEN_COL not in leiden_df.columns:
    raise ValueError(f"Could not find Leiden column '{LEIDEN_COL}' in {LEIDEN_FILE}")

gene_leiden = leiden_df[LEIDEN_COL].values

# Number of clusters
n_gene_clusters = len(np.unique(gene_leiden))
print("\nNumber of gene Leiden clusters:", n_gene_clusters)

if N_MORPH_CLUSTERS is None:
    n_morph_clusters = n_gene_clusters
else:
    n_morph_clusters = N_MORPH_CLUSTERS

print("Number of morphology clusters:", n_morph_clusters)

# ============================================================
# Morphology clustering
# ============================================================

X_morph = morph_df.values

if MORPH_CLUSTER_METHOD.lower() == "gmm":
    morph_model = GaussianMixture(n_components=n_morph_clusters, random_state=42)
    morph_clusters = morph_model.fit_predict(X_morph)
elif MORPH_CLUSTER_METHOD.lower() == "kmeans":
    morph_model = KMeans(n_clusters=n_morph_clusters, random_state=42, n_init=20)
    morph_clusters = morph_model.fit_predict(X_morph)
else:
    raise ValueError("MORPH_CLUSTER_METHOD must be 'gmm' or 'kmeans'")

# ============================================================
# Evaluation: Gene Leiden clusters vs Morphology clusters
# ============================================================

ari = adjusted_rand_score(morph_clusters, gene_leiden)
nmi = normalized_mutual_info_score(morph_clusters, gene_leiden)

print("\n========== Baseline 2: Gene -> Morphology ==========")
print("Comparison: gene Leiden clusters vs morphology clusters")
print(f"Clustering method for morphology: {MORPH_CLUSTER_METHOD}")
print(f"ARI = {ari:.4f}")
print(f"NMI = {nmi:.4f}")

# Save metrics
metrics_df = pd.DataFrame({
    "metric": ["ARI", "NMI"],
    "value": [ari, nmi]
})
metrics_df.to_csv(f"{PLOT_PREFIX}_metrics.csv", index=False)

# ============================================================
# Plot 1: gene tSNE colored by gene Leiden clusters
# ============================================================

plt.figure(figsize=(7, 6))
plt.scatter(
    tsne_df[TSNE_COL1],
    tsne_df[TSNE_COL2],
    c=gene_leiden,
    s=12
)
plt.xlabel(TSNE_COL1)
plt.ylabel(TSNE_COL2)
plt.title("Gene t-SNE colored by gene Leiden clusters")
plt.tight_layout()
plt.savefig(f"{PLOT_PREFIX}_tsne_gene_leiden.png", dpi=300)
plt.show()

# ============================================================
# Plot 2: gene tSNE colored by morphology clusters
# ============================================================

plt.figure(figsize=(7, 6))
plt.scatter(
    tsne_df[TSNE_COL1],
    tsne_df[TSNE_COL2],
    c=morph_clusters,
    s=12
)
plt.xlabel(TSNE_COL1)
plt.ylabel(TSNE_COL2)
plt.title("Gene t-SNE colored by morphology clusters")
plt.tight_layout()
plt.savefig(f"{PLOT_PREFIX}_tsne_morph_clusters.png", dpi=300)
plt.show()

# ============================================================
# Plot 3+: gene tSNE colored by continuous morphology features
# ============================================================

valid_features = [f for f in MORPH_FEATURES_TO_PLOT if f in morph_df.columns]

if len(MORPH_FEATURES_TO_PLOT) > 0 and len(valid_features) == 0:
    print("\nWarning: none of the requested morphology features were found.")
    print("Available morphology columns:")
    print(list(morph_df.columns))

for feat in valid_features:
    plt.figure(figsize=(7, 6))
    sc = plt.scatter(
        tsne_df[TSNE_COL1],
        tsne_df[TSNE_COL2],
        c=morph_df[feat],
        s=12
    )
    plt.xlabel(TSNE_COL1)
    plt.ylabel(TSNE_COL2)
    plt.title(f"Gene t-SNE colored by morphology feature: {feat}")
    plt.colorbar(sc, label=feat)
    plt.tight_layout()
    safe_feat = feat.replace("/", "_").replace(" ", "_")
    plt.savefig(f"{PLOT_PREFIX}_tsne_feature_{safe_feat}.png", dpi=300)
    plt.show()

# ============================================================
# Save combined table
# ============================================================

results_df = pd.DataFrame(index=common_cells)
results_df[TSNE_COL1] = tsne_df[TSNE_COL1]
results_df[TSNE_COL2] = tsne_df[TSNE_COL2]
results_df["gene_leiden_cluster"] = gene_leiden
results_df["morph_cluster"] = morph_clusters

results_df.to_csv(f"{PLOT_PREFIX}_combined_results.csv")

print("\nSaved files:")
print(f"- {PLOT_PREFIX}_metrics.csv")
print(f"- {PLOT_PREFIX}_tsne_gene_leiden.png")
print(f"- {PLOT_PREFIX}_tsne_morph_clusters.png")
print(f"- {PLOT_PREFIX}_combined_results.csv")
for feat in valid_features:
    safe_feat = feat.replace('/', '_').replace(' ', '_')
    print(f"- {PLOT_PREFIX}_tsne_feature_{safe_feat}.png")